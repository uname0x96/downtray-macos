{
  "sourceLanguage": "en",
  "strings": {
    "access.message": {
      "comment": "Folder picker heading, both for the first grant and for moving the inbox to another folder. Keep the brand name.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle den Ordner, dessen neue Dateien Downtray anzeigt. Meist ist das „Downloads“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the folder Downtray lists new files from. Downloads is the usual choice."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le dossier dont Downtray affiche les nouveaux fichiers. En général, c’est « Téléchargements »."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Downtray が新しいファイルを表示するフォルダを選択してください。通常は「ダウンロード」です。"
          }
        }
      }
    },
    "access.prompt": {
      "comment": "Folder picker button. Keep short.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auswählen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択"
          }
        }
      }
    },
    "action.copyName": {
      "comment": "Menu item and ⇧⌘C: puts the file's name on the clipboard.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Namen kopieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy Name"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copier le nom"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前をコピー"
          }
        }
      }
    },
    "action.copyPath": {
      "comment": "Menu item and ⌘C: puts the file's path on the clipboard.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pfad kopieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy Path"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copier le chemin"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスをコピー"
          }
        }
      }
    },
    "action.markRead": {
      "comment": "Menu item: clears the row's unread dot.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als gelesen markieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark as Read"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquer comme lu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既読にする"
          }
        }
      }
    },
    "action.markUnread": {
      "comment": "Menu item: puts the unread dot back.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als ungelesen markieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark as Unread"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquer comme non lu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未読にする"
          }
        }
      }
    },
    "action.move": {
      "comment": "Menu item and ⌘M: opens a folder picker.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewegen nach …"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move to…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer vers…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動…"
          }
        }
      }
    },
    "action.open": {
      "comment": "Menu item: open the file in its default app.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開く"
          }
        }
      }
    },
    "action.quickLook": {
      "comment": "Menu item: the macOS Quick Look preview. Use the system's name for it.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersicht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick Look"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coup d’œil"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クイックルック"
          }
        }
      }
    },
    "action.selectAll": {
      "comment": "⌘A.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles auswählen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select All"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout sélectionner"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてを選択"
          }
        }
      }
    },
    "action.showInFinder": {
      "comment": "Menu item and ⌘R: selects the file in a Finder window.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Finder zeigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show in Finder"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher dans le Finder"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder に表示"
          }
        }
      }
    },
    "action.trash": {
      "comment": "Menu item and ⌫.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den Papierkorb legen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move to Trash"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placer dans la corbeille"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱に入れる"
          }
        }
      }
    },
    "action.unzip": {
      "comment": "Menu item and ⌘U: extracts a zip next to itself.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier entpacken"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unzip Here"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décompresser ici"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに解凍"
          }
        }
      }
    },
    "app.name": {
      "comment": "Brand name. Do not translate or transliterate.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Downtray"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downtray"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Downtray"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Downtray"
          }
        }
      }
    },
    "app.quit": {
      "comment": "Menu item, ⌘Q and the red button at the end of Settings. Keep the brand name as is.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Downtray beenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit Downtray"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitter Downtray"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Downtray を終了"
          }
        }
      }
    },
    "common.add": {
      "comment": "Rule editor: saves a new rule.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinzufügen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加"
          }
        }
      }
    },
    "common.cancel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        }
      }
    },
    "common.save": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        }
      }
    },
    "empty.caughtUp": {
      "comment": "Empty state of the Unread chip: every file has been opened or marked read.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles gelesen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re all caught up"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes à jour"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて確認済みです"
          }
        }
      }
    },
    "empty.lastHour": {
      "comment": "Empty state of the 1h chip.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts in der letzten Stunde"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing in the last hour"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien depuis une heure"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この 1 時間に届いたものはありません"
          }
        }
      }
    },
    "empty.noMatches": {
      "comment": "Inbox (Pro) or History while the search finds nothing.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Treffer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No matches."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun résultat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一致するものはありません。"
          }
        }
      }
    },
    "empty.noMatches.hint": {
      "comment": "Under 'No matches' on the inbox: what the search understands.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche einen Dateinamen oder einen Typ wie pdf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a file name or type like pdf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez un nom de fichier ou un type comme pdf."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル名や「pdf」などの種類で探してみてください。"
          }
        }
      }
    },
    "empty.noRecent.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Dateien in „%@“ erscheinen hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New files in %@ will show up here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux fichiers de « %@ » apparaîtront ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」に届いた新しいファイルがここに表示されます。"
          }
        }
      },
      "comment": "Placeholder: the primary folder's name, usually Downloads."
    },
    "empty.noRecent.title": {
      "comment": "Empty state of the inbox when the watched folders hold nothing recent.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine neuen Downloads"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No recent downloads"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun téléchargement récent"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近のダウンロードはありません"
          }
        }
      }
    },
    "empty.openDownloads": {
      "comment": "Button under the empty inbox: opens the folder in Finder. Placeholder: the primary folder's name, usually Downloads.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner „%@“ öffnen"
          }
