        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open %@ Folder"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir le dossier « %@ »"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」フォルダを開く"
          }
        }
      }
    },
    "empty.today": {
      "comment": "Empty state of the Today chip.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute nichts"
